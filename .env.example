# Backend
PORT=3001
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3307
DB_USER=onboarding
DB_PASSWORD=onboarding_pass
DB_NAME=onboarding_reviewer

# Agent configuration
AGENT_MAX_RETRIES=2
AGENT_TIMEOUT_MS=30000

# LLM (optional - leave empty to use rule-based mock agents)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Frontend (Vite) — use /api in dev (Vite proxy) or full URL in production
VITE_API_BASE_URL=/api
